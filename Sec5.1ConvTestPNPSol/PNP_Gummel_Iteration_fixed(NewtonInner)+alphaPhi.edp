// ===========================================================================//
//                       PNP_Steady_State_NumericalSolver                     //
//                                Li Jiajie                                   //
//                             Gummel fixed point method                      //
// ===========================================================================//

// =======================mesh generation=====================================//
ofstream f("Gummel_fixed_error_results.txt",append);
f<<"BoundaryPointNum || L2c1 || L2c2 || L2phi || H1c1 || H1c2 || H1phi"<<endl;
for(int k=3;k<=9;k++)
{
int boundPointNum = 2^k;
mesh Th = square(boundPointNum,boundPointNum, flags=1);
// ===========================================================================//

// =======================marco command setting===============================//
macro grad(g) [dx(g), dy(g)] //
// ===========================================================================//

// =======================Constant parameters=================================//
// right hand side of PNP input(f1, f2, f3)

func f3 = sin(3*pi*x)*sin(3*pi*y) - sin(2*pi*x)*sin(2*pi*y) + (pi*cos(pi*x)*sin(pi*y))/2 - 2*pi^2*sin(pi*x)*sin(pi*y)*(x/2 - 1);

//sin(3*pi*x)*sin(3*pi*y) - sin(2*pi*x)*sin(2*pi*y) + 2*pi^2*sin(pi*x)*sin(pi*y);
// analytic solutions of PNP(phi, c1, c2)
func phi = sin(pi*x)*sin(pi*y);
func c1 = sin(2*pi*x)*sin(2*pi*y);
func c2 = sin(3*pi*x)*sin(3*pi*y);
func dc1dx = 2*pi*cos(2*pi*x)*sin(2*pi*y);
func dc1dy = 2*pi*cos(2*pi*y)*sin(2*pi*x);
func dc2dx = 3*pi*cos(3*pi*x)*sin(3*pi*y);
func dc2dy = 3*pi*cos(3*pi*y)*sin(3*pi*x);
func dphidx = pi*cos(pi*x)*sin(pi*y);
func dphidy = pi*cos(pi*y)*sin(pi*x);
func Dphi=0.5+0.5*x;
func Ephi=1.0-0.5*x;

// ===================== 重新严格计算的 f1、f2（唯一正确版） =====================
real alpha = 0.0;
func expAlpe = exp(alpha * x);
func D   = 0.5 * x + 0.5;

func f1 = (x/2.0 + 1.0/2.0)*(4*pi^2*sin(2*pi*x)*sin(2*pi*y) - 2*pi^2*cos(pi*y)*cos(2*pi*y)*sin(pi*x)*sin(2*pi*x) 
+ pi^2*sin(pi*x)*sin(2*pi*x)*sin(pi*y)*sin(2*pi*y)) + (x/2.0 + 1.0/2.0)*(4*pi^2*sin(2*pi*x)*sin(2*pi*y)
 + 2*alpha*pi*cos(2*pi*x)*sin(2*pi*y) - 2*pi^2*cos(pi*x)*cos(2*pi*x)*sin(pi*y)*sin(2*pi*y) 
 + pi^2*sin(pi*x)*sin(2*pi*x)*sin(pi*y)*sin(2*pi*y)) - pi*cos(2*pi*x)*sin(2*pi*y)
  + (alpha*sin(2*pi*x)*sin(2*pi*y))/2.0 - (pi*cos(pi*x)*sin(2*pi*x)*sin(pi*y)*sin(2*pi*y))/2.0;

func f2 = (x/2.0 + 1.0/2.0)*(9*pi^2*sin(3*pi*x)*sin(3*pi*y) + 3*pi^2*cos(pi*y)*cos(3*pi*y)*sin(pi*x)*sin(3*pi*x) 
- pi^2*sin(pi*x)*sin(3*pi*x)*sin(pi*y)*sin(3*pi*y)) + (x/2.0 + 1.0/2.0)*(9*pi^2*sin(3*pi*x)*sin(3*pi*y) 
+ 3*alpha*pi*cos(3*pi*x)*sin(3*pi*y) + 3*pi^2*cos(pi*x)*cos(3*pi*x)*sin(pi*y)*sin(3*pi*y)
 - pi^2*sin(pi*x)*sin(3*pi*x)*sin(pi*y)*sin(3*pi*y)) - (3*pi*cos(3*pi*x)*sin(3*pi*y))/2.0 
 + (alpha*sin(3*pi*x)*sin(3*pi*y))/2.0 + (pi*cos(pi*x)*sin(3*pi*x)*sin(pi*y)*sin(3*pi*y))/2.0;
 
// valence of two substances
int q1 = 1;
int q2 = -1;

// ===========================================================================//

// ==================Finite element and Variational form======================//
// setting of finite element space
fespace P1h(Th, P1);
P1h f1h=f1;P1h f2h=f2;P1h f3h=f3;
// state variables
P1h phih, dphih, c1h, c2h, rho1h, rho2h;
//adjoint varibale
P1h vh,expAlp;
P1h Dphih=Dphi, Ephih=Ephi;
// PNP in Slotboom transformed form
/*
problem Poisson(phih, vh)
        = int2d(Th)(grad(phih)'*grad(vh))
         - int2d(Th)(f3h*vh+rho1h*exp(-phiph)*vh-rho2h*exp(phiph)*vh)
        + on(1,2,3,4, phih=0);
*/
expAlp = expAlpe;
problem NewtonCorPoisson(dphih, vh)
        = int2d(Th)(Ephi*grad(dphih)'*grad(vh)+rho1h*exp(-phih)*dphih*vh+rho2h*exp(phih)*dphih*vh)
         + int2d(Th)(Ephi*grad(phih)'*grad(vh)-rho1h*exp(-phih)*vh+rho2h*exp(phih)*vh-f3*vh)
         + on(1,2,3,4, dphih=0);

problem NernstPlanck1(rho1h, vh)
        = int2d(Th)(Dphi*expAlp*[exp(-phih)*dx(rho1h), exp(-phih)*dy(rho1h)]'*grad(vh))
         - int2d(Th)(f1h*vh)
        + on(1,2,3,4, rho1h=0);

problem NernstPlanck2(rho2h, vh)
        = int2d(Th)(Dphi*expAlp*[exp(phih)*dx(rho2h), exp(phih)*dy(rho2h)]'*grad(vh))
         - int2d(Th)(f2h*vh)
        + on(1,2,3,4, rho2h=0);

// ===========================================================================//

// ========================Numerical algorithm solver=========================//
int maxiter = 20;
int i = 0;
real tol = 1e-5;

real c1L2Norm=1e3, c2L2Norm, phiL2Norm, c1H1Norm, c2H1Norm, phiH1Norm;
while(c1L2Norm + c2L2Norm + phiL2Norm > tol)
{
  i++;
  if(i > maxiter)
    break;

  // Nonlinear iteration
  for(int j;j < 5; j++)
  {
      NewtonCorPoisson;
      phih = phih+dphih;
  }
  NernstPlanck1;
  NernstPlanck2;

  // Slotboom inverse transformation
  c1h = rho1h*exp(-phih);
  c2h = rho2h*exp(phih);
  // Error estimate on L2 and H1 norm
  c1L2Norm = sqrt(int2d(Th)((c1h-c1)^2));
  c2L2Norm = sqrt(int2d(Th)((c2h-c2)^2));
  phiL2Norm = sqrt(int2d(Th)((phih-phi)^2));
  c1H1Norm = sqrt(int2d(Th)((dx(c1h)-dc1dx)^2+(dy(c1h)-dc1dy)^2))+c1L2Norm;
  c2H1Norm = sqrt(int2d(Th)((dx(c2h)-dc2dx)^2+(dy(c2h)-dc2dy)^2))+c2L2Norm;
  phiH1Norm = sqrt(int2d(Th)((dx(phih)-dphidx)^2+(dy(phih)-dphidy)^2))+phiL2Norm;

}
cout<<"With iteration "<<i<<" L2 Error estimate writes:"<<endl;
cout<<" c1 "<<c1L2Norm<<" c2 "<<c2L2Norm<<" phi "<<phiL2Norm<<endl;
cout<<" H1 Error estimate writes:"<<endl;
cout<<" c1 "<<c1H1Norm<<" c2 "<<c2H1Norm<<" phi "<<phiH1Norm<<endl;
f<<boundPointNum<<" "<<c1L2Norm<<" "<<c2L2Norm<<" "<<phiL2Norm<<" "<<c1H1Norm
  <<" "<<c2H1Norm<<" "<<phiH1Norm<<endl;

// Visualization
// plot(Th, wait=1);
// plot(phih, value=1, wait=1);
plot(c1h, value=1, wait=0);
plot(c2h, value=1, wait=0);
c1h =c1;
plot(c1h, value=1, wait=0);
}
