// ssP.N.P Topology Optimization
// Maximization the concentration of electrolyte species
// Freefem ++
// =========================Essential parameters==============================//
load "iovtk"
real eps0 = 0.5;
real epsm = 5.0;
real D0 = 0.5;
real Dm = 0.01;
real z1 = 1.0;
real z2 =-1.0;
real dt = 0.0002;
real kappa = 1e-3;
real Sta1 = 1.0;
real Sta2 = 0.01;
real beta = 500;
real VolTarg = 1.2;
real lag = 0.0;
real eta = 60.0;
real alpha = 1;
int GummelIter = 30;
int Gammain = 1;
int Gamma1  = 2;
int Gamma2  = 3;
int numBor = 100;
int nbtriangles;
int Niter = 100;
int PhaseIterNum = 10;
int innerIter = 4;
real cL2Norm;
real psiL2Norm;
real vol;
real[int] colorhsv=[ // color hsv model
 4./6., 0 , 1, // 
 4./6., 0 , 1, // 
 5./6., 1 , 1, //
 1, 1. , 1, // red
 1, 0.5 , 1 // light red
 ];
// =========================Mesh Generation===================================//
border edge1(t=0.0,1.0){x=t;  y=0.0; label=Gamma1;};
border edge2(t=0.0,1.0){x=1.0;  y=t; label=Gamma2;};
border edge3(t=1.0,0.0){x=t;  y=1.0; label=Gamma1;};
border edge4(t=1.0,0.0){x=0.0;  y=t; label=Gammain;};
mesh Th = buildmesh(edge1(numBor)+edge2(numBor)+edge3(numBor)+edge4(numBor));

// =======================marco command setting===============================//
macro grad(g) [dx(g), dy(g)] //

// =========================Dirichlet condition===============================//
func c0 = 0.5;
func psi0 = -0.5;
// ========================Finite element space===============================//
fespace Wh(Th, P1);
Wh c1,c2,psi,v,cp1,cp2,psip,dpsi,rho1,rho2,E1,E2;// state variables and test
Wh eps,D;
Wh s1,s2,zeta,v1,v2,v3;
Wh phi, phiold, r;

fespace Qh(Th, P0);
Qh Ea1,Ea2;


phi = 1.0*(x<0.5+0.1*sin(4*pi*y))+0.0*(x>=0.5+0.1*sin(4*pi*y));//1.0*(x<(1.0+0.25*sin(6*pi*y)))+0.0*(x>=(1.0+0.25*sin(6*pi*y)));//(1- ( 0.5*cos(pi*5*x+pi)*cos(pi*5*y)+0.5 ));//1.0*(x<(1.0+0.3*sin(6*pi*y)))+0.0*(x>=(1.0+0.3*sin(6*pi*y)));

// =========================Weak formulations=================================//

problem Poisson(psi, v)
        = int2d(Th)(eps*grad(psi)'*grad(v)) - int2d(Th)(phi*z1*c1*v+phi*z2*c2*v)
        + on(Gamma2, psi=psi0)+on(Gammain,psi=0.0);

problem NewtonCorPoisson(dpsi, v, init=0)
        = int2d(Th)(eps*grad(dpsi)'*grad(v)+exp(alpha*phi)*z1^2*rho1*exp(-z1*psi)*dpsi*v+exp(alpha*phi)*z2^2*rho2*exp(-z2*psi)*dpsi*v)
         + int2d(Th)(eps*grad(psi)'*grad(v)-exp(alpha*phi)*z1*rho1*exp(-z1*psi)*v-exp(alpha*phi)*z2*rho2*exp(-z2*psi)*v)
         + on(Gammain,Gamma2, dpsi=0);

problem NernstPlanck1Slot(rho1, v, init=0)//positive ion valence 1
        = int2d(Th)(D*exp(alpha*phi)*[Ea1*dx(rho1), Ea1*dy(rho1)]'*grad(v))
        + on(Gammain, rho1 = c0*exp(z1*psi)*exp(-alpha))+on(Gamma2,rho1=0);

problem NernstPlanck2Slot(rho2, v, init=0)//negative ion valence -1
        = int2d(Th)(D*exp(alpha*phi)*[Ea2*dx(rho2), Ea2*dy(rho2)]'*grad(v))
        + on(Gammain, rho2 = c0*exp(z2*psi)*exp(-alpha))+on(Gamma2,rho2=0);

verbosity = 0; //to remove all default output
c1 = c0;c2 = c0;
cp1 =c0; cp2 = c0; psi = psi0*(x>0.5)+0.0*(x<=1.0);
eps = eps0*phi^2+(1-phi^2)*epsm;
D = D0*phi^2+(1-phi^2)*Dm;

// step1: Calculate state variables

for (int i=1;i<=GummelIter;i++)
{
  for (int k=1;k<=innerIter;k++)// solve semi-linear Poisson problem
    {
      NewtonCorPoisson;
      psi = psi+dpsi;
    }

    E1  = exp(z1*psi);
    Ea1 = exp(-z1*psi);
    E2  = exp(z2*psi);
    Ea2 = exp(-z2*psi);
    //harmonic inverse average on constant of every unit
    nbtriangles = Th.nt;
    for (int l=0;l<nbtriangles;l++)
    {
      //a1 = Th(Th[l][0]).x;b1 = Th(Th[l][0]).y;a2 = Th(Th[l][1]).x;b2 = Th(Th[l][1]).y;a3 = Th(Th[l][2]).x;b3 = Th(Th[l][2]).y;
      Ea1[][Th[l]] = 3/(E1[][Th[l][0]]+E1[][Th[l][1]]+E1[][Th[l][2]]);
      Ea2[][Th[l]] = 3/(E2[][Th[l][0]]+E2[][Th[l][1]]+E2[][Th[l][2]]);
    }
  NernstPlanck1Slot;
  NernstPlanck2Slot;
  // Slotboom inverse transformation
  c1 = rho1*exp(-z1*psi)*exp(alpha*phi);
  c2 = rho2*exp(-z2*psi)*exp(alpha*phi);

  cL2Norm = int2d(Th)((cp1-c1)^2+(cp2-c2)^2);
  cL2Norm = sqrt(cL2Norm);
  psiL2Norm = int2d(Th)((psi-psip)^2);
  psiL2Norm = sqrt(psiL2Norm);
  cout<<" L2 norm of concentration c:"<<cL2Norm<<endl;
  cout<<" L2 norm of potential phi:"<<psiL2Norm<<endl;
  if (psiL2Norm + cL2Norm < 1e-8)
    break;
  psip = psi; cp1 = c1; cp2 = c2;
};
plot(c1,value=1,fill=1,wait=1);