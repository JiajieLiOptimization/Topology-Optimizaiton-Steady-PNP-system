// P.N.P shape Optimization 3d space
// Maximization the concentration of electrolyte species
// 2 species
// Freefem ++
load "lapack" // For call matrix inverse
load "iovtk"
load "msh3"
include "cube.idp"

// ===========================================
//								mesh import
// ===========================================
mesh3 Th;
Th = readmesh3("Exp3Case2Mesh");

// ===========================================
//            parameters setting
// ===========================================
real eps0 = 0.5;
real epsm = 5.0;
real D0 = 0.5;
real Dm = 0.01;
real z1 = 1.0;
real z2 =-1.0;
real dt = 0.0001;
real kappa = 1e-3;
real Sta1 = 1.0;
real Sta2 = 5;
real beta = 200;
real VolTarg = 0.3*int3d(Th)(1.0);
real lag = 0.0;
real eta = 10.0;
real cL2Norm;
real psiL2Norm;
real vol;

int GummelIter=10;
int Gammain = 4;
int[int] Gamma1 = [2,3];
int[int] Gamma2 = [1];
int innerIter=4;
int nbtriangles;
int Niter = 150;
int PhaseIterNum = 10;

// ===========================================
//                define macro
// ===========================================
macro grad(g) [dx(g), dy(g), dz(g)] //


// ===========================================
//            finite element space
// ===========================================
func c01 = 0.5;
func c02 = 0.5;
func psi0 = -0.5;
func phi0 = (1- ( 0.5*cos(pi*4*x+pi)*cos(pi*4*y)*cos(pi*4*z+pi/2)+0.5 ));


fespace Wh(Th, P1);
Wh c1,c2,v1,cp1,cp2,psi,dpsi,psip,rho1,rho2,E1,E2;// state variables and test
Wh eps,D;// coefficient
Wh s1,s2,zeta,v2,v3;// adjoint variables and test
Wh phi=phi0,phiold=phi0,r;// phase field

plot(phi,wait=1,value=1);
fespace Qh(Th, P0);
Qh Ea1,Ea2;

// ===========================================
//            P.D.E setting
// ===========================================

problem NewtonCorPoisson(dpsi, v1, solver=sparsesolver)
        = int3d(Th)(eps*grad(dpsi)'*grad(v1)+phi*z1^2*rho1*exp(-z1*psi)*dpsi*v1+phi*z2^2*rho2*exp(-z2*psi)*dpsi*v1)
         + int3d(Th)(eps*grad(psi)'*grad(v1)-phi*z1*rho1*exp(-z1*psi)*v1-phi*z2*rho2*exp(-z2*psi)*v1)
         + on(Gammain,Gamma2, dpsi=0);


problem NernstPlanck1(rho1, v1, solver=sparsesolver)//positive ion valence 1
        = int3d(Th)(D*[Ea1*dx(rho1), Ea1*dy(rho1), Ea1*dz(rho1)]'*grad(v1))
        + on(Gammain, rho1 = c01*exp(z1*psi))+on(Gamma2,rho1=0);

problem NernstPlanck2(rho2, v1, solver=sparsesolver)//positive ion valence -1
        = int3d(Th)(D*[Ea2*dx(rho2), Ea2*dy(rho2), Ea2*dz(rho2)]'*grad(v1))
        + on(Gammain, rho2 = c02*exp(z2*psi))+on(Gamma2,rho2=0);

problem adjoint([s1,s2,zeta],[v1,v2,v3], solver=sparsesolver)
        = int3d(Th)(D*grad(s1)'*grad(v1)+D*grad(s1)'*[z1*v1*dx(psi), z1*v1*dy(psi), z1*v1*dz(psi)])
          +int3d(Th)(z1*psi*v1)- int3d(Th)(z1*phi*zeta*v1)
          +int3d(Th)(D*grad(s2)'*grad(v2)+D*grad(s2)'*[z2*v2*dx(psi), z2*v2*dy(psi), z2*v2*dz(psi)])
          +int3d(Th)(z2*psi*v2)- int3d(Th)(z2*phi*zeta*v2)
          +int3d(Th)(eps*grad(zeta)'*grad(v3)+z1*D*c1*grad(s1)'*grad(v3)+z2*D*c2*grad(s2)'*grad(v3))
        + on(Gammain,Gamma2, s1=0,s2=0) + on(Gamma2,Gammain, zeta=0);

problem AllenCahn(phi,v1,solver=sparsesolver) = int3d(Th)(phi*v1) - int3d(Th)(phiold*v1)
+ int3d(Th)(dt*kappa*grad(phi)'*grad(v1))
+ int3d(Th)(Sta1*dt*phi*v1)-int3d(Th)(Sta1*dt*phiold*v1) 
+ int3d(Th)(Sta2*dt*grad(phi)'*grad(v1))-int3d(Th)(Sta2*dt*grad(phiold)'*grad(v1)) 
+ int3d(Th)(dt*beta*(vol-VolTarg)*v1+dt*lag*v1)
- int3d(Th)(1/(0.01)*dt*phiold*(1-phiold)*(phiold-0.5)*v1)
+ int3d(Th)(dt*r*v1)+ on(Gamma2,phi=0)+ on(Gammain,phi=1);
vol = int3d(Th)(phiold);

string outputFile0 = "./initialmesh" + ".vtk";
savevtk(outputFile0,Th,c1,dataname="concentration");
// ===========================================
//            Shape Optimization procedure
// ===========================================
for(int i=1; i<=Niter; i++)
{
  // step1: Calculate state variables
  verbosity = 0; //to remove all default output
  c1 = c01;c2 = c02;
  cp1 =c01; cp2 = c02; psi = -0.5*(x^2+y^2>0.0625)+0.0*(x^2+y^2<=0.0625);
  eps = eps0*phi^2+(1-phi^2)*epsm;
  D = D0*phi^2+(1-phi^2)*Dm;
for (int i=1;i<=GummelIter;i++)
{
	for (int k=1;k<=innerIter;k++)// solve semi-linear Poisson problem
		{
			NewtonCorPoisson;
			psi = psi+dpsi;
		}

	E1  = exp(z1*psi);
	Ea1 = exp(-z1*psi);
	E2  = exp(z2*psi);
	Ea2 = exp(-z2*psi);
	//harmonic inverse average on constant of every unit
	nbtriangles = Th.nt;
	for (int l=0;l<nbtriangles;l++)
	{
		//a1 = Th(Th[l][0]).x;b1 = Th(Th[l][0]).y;a2 = Th(Th[l][1]).x;b2 = Th(Th[l][1]).y;a3 = Th(Th[l][2]).x;b3 = Th(Th[l][2]).y;
		Ea1[][Th[l]] = 4/(E1[][Th[l][0]]+E1[][Th[l][1]]+E1[][Th[l][2]]+E1[][Th[l][3]]);
		Ea2[][Th[l]] = 4/(E2[][Th[l][0]]+E2[][Th[l][1]]+E2[][Th[l][2]]+E2[][Th[l][3]]);
	}

	NernstPlanck1;
	NernstPlanck2;

	// Slotboom inverse transformation
	c1 = rho1*exp(-z1*psi);
	c2 = rho2*exp(-z2*psi);

	cL2Norm = int3d(Th)((cp1-c1)^2+(cp2-c2)^2);
	cL2Norm = sqrt(cL2Norm);
	psiL2Norm = int3d(Th)((psi-psip)^2);
	psiL2Norm = sqrt(psiL2Norm);
	cout<<" L2 norm of concentration c:"<<cL2Norm<<endl;
	cout<<" L2 norm of potential phi:"<<psiL2Norm<<endl;
	if (psiL2Norm + cL2Norm < 1e-5)
	break;
	psip = psi; cp1 = c1; cp2 = c2;
};
verbosity = 1;
  adjoint;

  real norm = int3d(Th)((-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi), z1*c1*dz(psi)]
                                              +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi), z2*c2*dz(psi)])
                                              -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta))^2); 
  real sqrtnorm = sqrt(norm);

  // updating r
  r = -eta/sqrtnorm*(-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi), z1*c1*dz(psi)]
                                          +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi), z2*c2*dz(psi)])
                                          -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta));

  for(int k=0;k<PhaseIterNum;k++)
  {
     AllenCahn;
     phiold = phi;
     phiold = max(0,phiold);
     phiold = min(phiold,1);
		 vol = int3d(Th)(phiold);
  }  
    phi = phiold;
     phi = max(0,phi);
     phi = min(phi,1);
     lag = lag+0.5*(vol-VolTarg);
    
    real J = int3d(Th)(phi*z1*c1+phi*z2*c2);
    cout<<"concentration: "<<J<<endl;
    real   Wtotal = -J + 0.5*beta*(vol-VolTarg)^2 + int3d(Th)(0.5*kappa*grad(phi)'*grad(phi)+1/(0.01)*0.25*(phi-1)^2*phi^2);
    cout<<"total energy: "<<Wtotal<<endl;

    ofstream obj("obj.txt",append);
    obj<<J <<endl;

    ofstream Verr("VolumeErrBou.txt",append);
    Verr<<abs(vol-VolTarg)<<endl;

    ofstream Ene("totalenergy.txt",append);
    Ene<<Wtotal<<endl;

    string caption= " Objective: "+J +" total energy: "+Wtotal+" volume error: "+ abs(vol-VolTarg)+ " iter :"+i;

  plot(phi,cmm=caption,fill=1,value=1);//,hsv=colorhsv
  savevtk("phi_"+i+".vtk",Th,phi,dataname="phi");
  savevtk("c1_"+i+".vtk",Th,c1,dataname="c1");
  savevtk("c2_"+i+".vtk",Th,c2,dataname="c2");
  if(eps0>0.01)
  {
    eps0=0.95*eps0;
  }
  if(eps0<0.01)
  {
    eps0 = 0.01;
  }
  cout<<"eps0: "<<eps0<<endl;
}
c1 = c1*phi;
c2 = c2*phi;
psi = psi*phi;
savevtk("c1.vtk",Th,c1,dataname="c1");
savevtk("c2.vtk",Th,c2,dataname="c2");
savevtk("psi.vtk",Th,psi,dataname="psi");