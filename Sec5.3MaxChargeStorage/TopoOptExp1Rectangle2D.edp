// ssP.N.P Topology Optimization																						//
// Maximization the concentration of electrolyte species																//
// This script performs 2D topology optimization of supercapacitor electrodes on a (0,1)times(0,2) rectangular domain,	//
// maximizing net charge storage under steady-state PNP constraints via a stabilized gradient flow scheme. It tests 	//
// multiple initial phase-field modes and corresponds to Section 5.3 Example 1 and Figs. 5.4–5.6.						//
// Modifying line 67 to select different holes for initial phase field function											//
// =========================Essential parameters==============================//

load "iovtk"
real eps0 = 0.5;
real epsm = 5.0;
real D0 = 0.5;
real Dm = 0.01;
real z1 = 1.0;
real z2 =-1.0;
real dt = 0.0002;
real kappa = 1e-3;
real Sta1 = 1.0;
real Sta2 = 0.01;
real beta = 500;
real VolTarg = 1.0;
real lag = 0.0;
real eta = 240.0;
int GummelIter = 30;
int Gammain = 1;
int Gamma1  = 2;
int Gamma2  = 3;
int numBor = 100;
int nbtriangles;
int Niter = 150;
int PhaseIterNum = 10;
int innerIter = 4;
real cL2Norm;
real psiL2Norm;
real vol;
real[int] colorhsv=[ // color hsv model
 4./6., 0 , 1, // 
 4./6., 0 , 1, // 
 5./6., 1 , 1, //
 1, 1. , 1, // red
 1, 0.5 , 1 // light red
 ];
// =========================Mesh Generation===================================//
border edge1(t=0.0,1.0){x=t;  y=0.0; label=Gamma1;};
border edge2(t=0.0,2.0){x=1.0;  y=t; label=Gamma2;};
border edge3(t=1.0,0.0){x=t;  y=2.0; label=Gamma1;};
border edge4(t=2.0,0.0){x=0.0;  y=t; label=Gammain;};
mesh Th = buildmesh(edge1(numBor)+edge2(2*numBor)+edge3(numBor)+edge4(2*numBor));

// =======================marco command setting===============================//
macro grad(g) [dx(g), dy(g)] //

// =========================Dirichlet condition===============================//
func c0 = 0.5;
func psi0 = -0.5;
// ========================Finite element space===============================//
fespace Wh(Th, P1);
Wh c1,c2,psi,v,cp1,cp2,psip,dpsi,rho1,rho2,E1,E2;// state variables and test
Wh eps,D;
Wh s1,s2,zeta,v1,v2,v3;
Wh phi, phiold, r;

fespace Qh(Th, P0);
Qh Ea1,Ea2;


phi = (1- ( 0.5*cos(pi*6*x+pi)*cos(pi*6*y)+0.5 ))*(x<=0.75)+0.0*(x>=0.75);//1.0*(x<(1.0+0.25*sin(6*pi*y)))+0.0*(x>=(1.0+0.25*sin(6*pi*y)));//(1- ( 0.5*cos(pi*5*x+pi)*cos(pi*5*y)+0.5 ));//1.0*(x<(1.0+0.3*sin(6*pi*y)))+0.0*(x>=(1.0+0.3*sin(6*pi*y)));
phiold = phi;
include "PDE_state_adjoint_gradflow_solver_2d.edp"
vol = int2d(Th)(phiold);

plot(phi,fill=1,hsv=colorhsv,ps="ini.eps");
for(int i=1; i<=Niter; i++)
{
  verbosity = 0; //to remove all default output
  c1 = c0;c2 = c0;
  cp1 =c0; cp2 = c0; psi = psi0*(x>0.5)+0.0*(x<=0.5);
  eps = eps0*phi^2+(1-phi^2)*epsm;
  D = D0*phi^2+(1-phi^2)*Dm;

 // step1: Calculate state variables

  for (int i=1;i<=GummelIter;i++)
  {
    for (int k=1;k<=innerIter;k++)// solve semi-linear Poisson problem
      {
        NewtonCorPoisson;
        psi = psi+dpsi;
      }

			E1  = exp(z1*psi);
	    Ea1 = exp(-z1*psi);
			E2  = exp(z2*psi);
	    Ea2 = exp(-z2*psi);
	    //harmonic inverse average on constant of every unit
	    nbtriangles = Th.nt;
	    for (int l=0;l<nbtriangles;l++)
	    {
	      //a1 = Th(Th[l][0]).x;b1 = Th(Th[l][0]).y;a2 = Th(Th[l][1]).x;b2 = Th(Th[l][1]).y;a3 = Th(Th[l][2]).x;b3 = Th(Th[l][2]).y;
	      Ea1[][Th[l]] = 3/(E1[][Th[l][0]]+E1[][Th[l][1]]+E1[][Th[l][2]]);
	      Ea2[][Th[l]] = 3/(E2[][Th[l][0]]+E2[][Th[l][1]]+E2[][Th[l][2]]);
	    }
    NernstPlanck1Slot;
		NernstPlanck2Slot;
    // Slotboom inverse transformation
    c1 = rho1*exp(-z1*psi);
		c2 = rho2*exp(-z2*psi);

    cL2Norm = int2d(Th)((cp1-c1)^2+(cp2-c2)^2);
    cL2Norm = sqrt(cL2Norm);
    psiL2Norm = int2d(Th)((psi-psip)^2);
    psiL2Norm = sqrt(psiL2Norm);
    if (psiL2Norm + cL2Norm < 1e-8)
    {
    cout<<" Total number of Gummel scheme using Newton inner iteration :"<<i<<endl;
    cout<<" After Gummel scheme, L2-err norm of concentration c:"<<cL2Norm<<endl;
    cout<<" After Gummel scheme, L2-err norm of potential phi:"<<psiL2Norm<<endl;
    
    break;
    }
    psip = psi; cp1 = c1; cp2 = c2;
  };

  Adjoint;

  real norm = int2d(Th)((-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi)]
                                              +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi)])
                                              -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta))^2); 
  real sqrtnorm = sqrt(norm);

  // updating r
  r = -eta/sqrtnorm*(-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi)]
                                          +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi)])
                                          -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta));

  
  for(int k=0;k<PhaseIterNum;k++)
  {
     AllenCahn;
     phiold = phi;
     phiold = max(0,phiold);
     phiold = min(phiold,1);
		 vol = int2d(Th)(phiold);
  }
     phi = max(0,phi);
     phi = min(phi,1);
     lag = lag+0.5*(vol-VolTarg);
  

real J = int2d(Th)(phi*z1*c1+phi*z2*c2);
real   Wtotal = -J + 0.5*beta*(vol-VolTarg)^2 + int2d(Th)(0.5*kappa*grad(phi)'*grad(phi)+1/(0.01)*0.25*(phi-1)^2*phi^2);

cout<<"Iter time :"<<i<<" total energy: "<<Wtotal<<" concentration: "<<J<<" volume error: "<<abs(vol-VolTarg)<<endl;


ofstream obj("obj.txt",append);
obj<<J <<endl;

ofstream Verr("VolumeErrBou.txt",append);
Verr<<abs(vol-VolTarg)<<endl;

ofstream Ene("totalenergy.txt",append);
Ene<<Wtotal<<endl;

string caption= " Objective: "+J +" total energy: "+Wtotal+" volume error: "+ abs(vol-VolTarg)+ " iter :"+i;

plot(phi,cmm=caption,fill=1,value=1,hsv=colorhsv);//,hsv=colorhsv

if(i ==5 || i == 10 || i == Niter-1)
{
  plot(phi,fill=1,hsv=colorhsv,ps="phi"+i+".eps");
}

if(i == Niter-1)
{
  c1 = c1*phi;c2=c2*phi;
  savevtk("c1.vtk",Th,c1,dataname="c1");
  savevtk("c2.vtk",Th,c2,dataname="c2");
  savevtk("psi.vtk",Th,psi,dataname="psi");
}

if (eps0>0.01)
{
  eps0 = 0.95*eps0;
}

if (eps0<0.01)
{
  eps0 = 0.01;
}
}
