// ssP.N.P Topology Optimization
// Maximization the concentration of electrolyte species
// Freefem ++
// =========================Essential parameters==============================//
load "iovtk"
real eps0 = 0.5;
real epsm = 1.0;
real D0 = 0.5;
real Dm = 0.01;
real z1 = 1.0;
real z2 =-1.0;
real dt = 0.001;
real kappa = 1e-3;
real Sta1 = 1.0;
real Sta2 = 0.1;
real beta = 500;

real lag = 0.0;
real eta = 90.0;
int GummelIter = 30;
int Gammain = 1;
int Gamma1  = 2;
int Gamma2  = 3;
int numBor = 75;
int nbtriangles;
int Niter = 175;
int PhaseIterNum = 10;
int innerIter = 4;
real cL2Norm;
real psiL2Norm;
real vol;
real[int] colorhsv=[ // color hsv model
 4./6., 0 , 1, // 
 4./6., 0 , 1, // 
 5./6., 1 , 1, //
 1, 1. , 1, // red
 1, 0.5 , 1 // light red
 ];

 real rr = 0.5;
 real R = 1;
// =========================Mesh Generation===================================//
// border edge1(t=0.0,2.0){x=t;  y=0.0; label=Gamma1;};
// border edge2(t=0.0,1.0){x=2.0;  y=t; label=Gamma2;};
// border edge3(t=2.0,0.0){x=t;  y=1.0; label=Gamma1;};
// border edge4(t=1.0,0.0){x=0.0;  y=t; label=Gammain;};

border InnCircle(t=2,0){x=rr*cos(pi*t);y=rr*sin(pi*t);label=Gammain;};
border OutCircle(t=0,2){x=R*cos(pi*t);y=R*sin(pi*t);label=Gamma2;};
mesh Th = buildmesh(InnCircle(2.5*numBor)+OutCircle(5*numBor));
plot(Th,wait=1);
real VolTarg = 0.5*int2d(Th)(1.0);
// =======================marco command setting===============================//
macro grad(g) [dx(g), dy(g)] //

// =========================Dirichlet condition===============================//
func c0 = 0.5;
func psi0 = -0.5;
// ========================Finite element space===============================//
fespace Wh(Th, P1);
Wh c1,c2,psi,v,cp1,cp2,psip,dpsi,rho1,rho2,E1,E2;// state variables and test
Wh eps,D;
Wh s1,s2,zeta,v1,v2,v3;
Wh phi, phiold, r;

fespace Qh(Th, P0);
Qh Ea1,Ea2;


phi = (1- ( 0.5*cos(pi*10*x+pi)*cos(pi*10*y)+0.5 ))*(x^2+y^2<0.8)+0.0*(x^2+y^2>=0.8);//1.0*(x<(1.0+0.25*sin(6*pi*y)))+0.0*(x>=(1.0+0.25*sin(6*pi*y)));//(1- ( 0.5*cos(pi*5*x+pi)*cos(pi*5*y)+0.5 ));//1.0*(x<(1.0+0.3*sin(6*pi*y)))+0.0*(x>=(1.0+0.3*sin(6*pi*y)));
phiold = phi;
// =========================Weak formulations=================================//
problem NernstPlanck1(c1, v)
        = int2d(Th)(D*[dx(c1) + z1*c1*dx(psi), dy(c1) + z1*c1*dy(psi)]'*grad(v))
        + on(Gammain, c1=0.5)+ on(Gamma2, c1=0);

problem NernstPlanck2(c2, v)
        = int2d(Th)(D*[dx(c2) + z2*c2*dx(psi), dy(c2) + z2*c2*dy(psi)]'*grad(v))
        + on(Gammain, c2=0.5)+ on(Gamma2, c2=0);

problem Poisson(psi, v)
        = int2d(Th)(eps*grad(psi)'*grad(v)) - int2d(Th)(phi*z1*c1*v+phi*z2*c2*v)
        + on(Gamma2, psi=psi0)+on(Gammain,psi=0.0);

problem NewtonCorPoisson(dpsi, v, init=0)
        = int2d(Th)(eps*grad(dpsi)'*grad(v)+phi*z1^2*rho1*exp(-z1*psi)*dpsi*v+phi*z2^2*rho2*exp(-z2*psi)*dpsi*v)
         + int2d(Th)(eps*grad(psi)'*grad(v)-phi*z1*rho1*exp(-z1*psi)*v-phi*z2*rho2*exp(-z2*psi)*v)
         + on(Gammain,Gamma2, dpsi=0);

problem NernstPlanck1Slot(rho1, v, init=0)//positive ion valence 1
        = int2d(Th)(D*[Ea1*dx(rho1), Ea1*dy(rho1)]'*grad(v))
        + on(Gammain, rho1 = c0*exp(z1*psi))+on(Gamma2,rho1=0);

problem NernstPlanck2Slot(rho2, v, init=0)//negative ion valence -1
        = int2d(Th)(D*[Ea2*dx(rho2), Ea2*dy(rho2)]'*grad(v))
        + on(Gammain, rho2 = c0*exp(z2*psi))+on(Gamma2,rho2=0);

problem Adjoint([s1,s2,zeta],[v1,v2,v3])
        = int2d(Th)(D*grad(s1)'*grad(v1) + D*grad(s1)'*[z1*v1*dx(psi), z1*v1*dy(psi)])
          +int2d(Th)(z1*psi*v1)- int2d(Th)(z1*phi*zeta*v1)
          +int2d(Th)(D*grad(s2)'*grad(v2) + D*grad(s2)'*[z2*v2*dx(psi), z2*v2*dy(psi)])
          +int2d(Th)(z2*psi*v2)- int2d(Th)(z2*phi*zeta*v2)
          +int2d(Th)(eps*grad(zeta)'*grad(v3)+z1*D*c1*grad(s1)'*grad(v3)+z2*D*c2*grad(s2)'*grad(v3))
          + on(Gammain,Gamma2, s1=0,s2=0) + on(Gamma2,Gammain, zeta=0);

problem AllenCahn(phi,v) = int2d(Th)(phi*v) - int2d(Th)(phiold*v)
+ int2d(Th)(dt*kappa*grad(phi)'*grad(v))
+ int2d(Th)(Sta1*dt*phi*v)-int2d(Th)(Sta1*dt*phiold*v) 
+ int2d(Th)(Sta2*dt*grad(phi)'*grad(v))-int2d(Th)(Sta2*dt*grad(phiold)'*grad(v)) 
+ int2d(Th)(dt*beta*(vol-VolTarg)*v+dt*lag*v)
- int2d(Th)(1/(0.01)*dt*phiold*(1-phiold)*(phiold-0.5)*v)
+ int2d(Th)(dt*r*v)+ on(Gamma2,phi=0);
vol = int2d(Th)(phiold);

plot(phi,fill=1,hsv=colorhsv,ps="ini.eps");
for(int i=1; i<=Niter; i++)
{
  verbosity = 0; //to remove all default output
  c1 = c0;c2 = c0;
  cp1 =c0; cp2 = c0; psi = psi0*(x^2+y^2>0.25)+0.0*(x^2+y^2<=0.25);
  eps = eps0*phi^2+(1-phi^2)*epsm;
  D = D0*phi^2+(1-phi^2)*Dm;

 // step1: Calculate state variables

  for (int i=1;i<=GummelIter;i++)
  {
    for (int k=1;k<=innerIter;k++)// solve semi-linear Poisson problem
      {
        NewtonCorPoisson;
        psi = psi+dpsi;
      }

			E1  = exp(z1*psi);
	    Ea1 = exp(-z1*psi);
			E2  = exp(z2*psi);
	    Ea2 = exp(-z2*psi);
	    //harmonic inverse average on constant of every unit
	    nbtriangles = Th.nt;
	    for (int l=0;l<nbtriangles;l++)
	    {
	      //a1 = Th(Th[l][0]).x;b1 = Th(Th[l][0]).y;a2 = Th(Th[l][1]).x;b2 = Th(Th[l][1]).y;a3 = Th(Th[l][2]).x;b3 = Th(Th[l][2]).y;
	      Ea1[][Th[l]] = 3/(E1[][Th[l][0]]+E1[][Th[l][1]]+E1[][Th[l][2]]);
	      Ea2[][Th[l]] = 3/(E2[][Th[l][0]]+E2[][Th[l][1]]+E2[][Th[l][2]]);
	    }
    NernstPlanck1Slot;
		NernstPlanck2Slot;
    // Slotboom inverse transformation
    c1 = rho1*exp(-z1*psi);
		c2 = rho2*exp(-z2*psi);

    cL2Norm = int2d(Th)((cp1-c1)^2+(cp2-c2)^2);
    cL2Norm = sqrt(cL2Norm);
    psiL2Norm = int2d(Th)((psi-psip)^2);
    psiL2Norm = sqrt(psiL2Norm);
    cout<<" L2 norm of concentration c:"<<cL2Norm<<endl;
    cout<<" L2 norm of potential phi:"<<psiL2Norm<<endl;
    if (psiL2Norm + cL2Norm < 1e-8)
      break;
    psip = psi; cp1 = c1; cp2 = c2;
  };

  Adjoint;

  real norm = int2d(Th)((-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi)]
                                              +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi)])
                                              -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta))^2); 
  real sqrtnorm = sqrt(norm);

  // updating r
  r = -eta/sqrtnorm*(-(2*D0*phi-2*Dm*phi)*(grad(s1)'*grad(c1) + grad(s1)'*[z1*c1*dx(psi), z1*c1*dy(psi)]
                                          +grad(s2)'*grad(c2) + grad(s2)'*[z2*c2*dx(psi), z2*c2*dy(psi)])
                                          -z1*c1-z2*c2+z1*c1*zeta+z2*c2*zeta -(2*eps0*phi-2*epsm*phi)*grad(psi)'*grad(zeta));

  
  for(int k=0;k<PhaseIterNum;k++)
  {
     AllenCahn;
     phiold = phi;
     phiold = max(0,phiold);
     phiold = min(phiold,1);
		 vol = int2d(Th)(phiold);
  }
     phi = max(0,phi);
     phi = min(phi,1);
     lag = lag+0.5*(vol-VolTarg);
  

real J = int2d(Th)(phi*z1*c1+phi*z2*c2);
cout<<"concentration: "<<J<<endl;
real   Wtotal = -J + 0.5*beta*(vol-VolTarg)^2 + int2d(Th)(0.5*kappa*grad(phi)'*grad(phi)+1/(0.01)*0.25*(phi-1)^2*phi^2);
cout<<"total energy: "<<Wtotal<<endl;

ofstream obj("obj.txt",append);
obj<<J <<endl;

ofstream Verr("VolumeErrBou.txt",append);
Verr<<abs(vol-VolTarg)<<endl;

ofstream Ene("totalenergy.txt",append);
Ene<<Wtotal<<endl;

string caption= " Objective: "+J +" total energy: "+Wtotal+" volume error: "+ abs(vol-VolTarg)+ " iter :"+i;

plot(phi,cmm=caption,fill=1,value=1,hsv=colorhsv);//,hsv=colorhsv

if(i ==5 || i == 10 || i == Niter-1)
{
  plot(phi,fill=1,hsv=colorhsv,ps="phi"+i+".eps");
}
if(i == Niter-1)
{
  c1 = c1*phi;c2=c2*phi;
  savevtk("c1.vtk",Th,c1,dataname="c1");
  savevtk("c2.vtk",Th,c2,dataname="c2");
  savevtk("psi.vtk",Th,psi,dataname="psi");
}
if (eps0>0.01)
{
  eps0 = 0.95*eps0;
}

if (eps0<0.01)
{
  eps0 = 0.01;
}
cout<<"eps0: "<<eps0<<endl;

}
Qh u1,u2;
u1 = -dx(psi);
u2 = -dy(psi);
// for velocity
ofstream ffuv("electric.dat");
ffuv<<"Variables="<<"X"<<","<<"Y"<<","<<"u"<<","<<"v"<<","<<"M"<<endl;
ffuv<<"Zone"<<"   "<<"N="<<Th.nv<<","<<"E="<<Th.nt<<","<<"F=FEPOINT,ET=TRIANGLE"<<endl;


// out put for domain 1 velocity, pressure temparature
	 int i,j;
//
	for( i=0;i<Th.nv;i++)
	{
	//ffnt<<Th(i).x<<"   "<<Th(i).y<<"   "<<T(Th(i).x,Th(i).y)<<endl;
		ffuv<<Th(i).x<<"   "<<Th(i).y<<"   "<<u1(Th(i).x,Th(i).y)<<"   "<<u2(Th(i).x,Th(i).y)<<"     "<<sqrt(u1^2+u2^2)(Th(i).x,Th(i).y)<<endl;
	}
//
	for(i=0;i<Th.nt;i++)
	{
	for( j=0;j<3;j++)
	{
	//ffnt<<Th[i][j]+1<<"  ";
	ffuv<<Th[i][j]+1<<"  ";
		}
	if(j==3)
	{
	//ffnt<<endl;
	ffuv<<endl;
		}
 }